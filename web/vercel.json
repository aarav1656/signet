{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/mcp", "destination": "https://chiron-mcp.vercel.app/api/mcp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
